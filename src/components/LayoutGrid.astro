---
---
<div class="layout-grid">
  <slot name="left" />
  <slot name="right" />
</div>

<style>
  .layout-grid {
    position: relative;
    align-items: start;
    align-content: stretch;
    display: grid;
    gap: 2rem;
    grid-template-columns: 2fr 5fr;
    /* 4 rows = card count in the homepage's longer (right) column, so it can
       share row-height with the left column via subgrid. Bump if that count changes. */
    grid-template-rows: repeat(4, auto);
  }

  @media screen and (max-width: 1380px) {
    .layout-grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 640px) {
    .layout-grid {
      margin: 0 1rem;
      gap: 1rem;
    }
  }
</style>